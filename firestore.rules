rules_version = '2';

// Regras de Segurança do Firestore — Ciclo Consciente
//
// Modelo de compartilhamento (instrutora / parceiro):
//   1. A aluna gera um link -> cria um doc em shares/{shareId}. O shareId é um
//      ID automático do Firestore (~120 bits), imprevisível na prática — ele
//      É o token de acesso.
//   2. Quem recebe o link (instrutora ou parceiro), estando autenticado, lê
//      shares/{shareId} e cria um "grant" em grants/{ownerUid}_{leitorUid}.
//      A criação só é aceita se o share existir, apontar para aquela dona e
//      ainda não ter expirado — validado aqui nas regras, não no app.
//   3. Com o grant existindo, o leitor passa a poder ler os registros da
//      aluna. Como o ID do grant é derivável do caminho pedido
//      (userId + '_' + uid de quem pede), a regra consegue checar sem query.
//   4. A aluna revoga a qualquer momento apagando o share e o grant.
//
// Vantagem sobre a versão anterior: não depende de Cloud Function implantada
// (plano Blaze) para o vínculo funcionar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Existe um grant válido de {ownerId} para quem está fazendo a requisição?
    function temGrant(ownerId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/grants/$(ownerId + '_' + request.auth.uid));
    }

    function ehDono(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, create, update: if ehDono(userId);
      // Necessário para a função "Excluir minha conta" (LGPD).
      allow delete: if ehDono(userId);

      // Registros diários: a dona sempre; quem tem grant válido só lê.
      // Ninguém além da dona escreve aqui — nem o parceiro. Ele sugere
      // (abaixo) e ela aprova, e é a aprovação dela que grava o registro.
      match /records/{recordId} {
        allow read:  if ehDono(userId) || temGrant(userId);
        allow write: if ehDono(userId);
      }

      // Sugestões de registro feitas pelo parceiro.
      // Ele cria; ela lê, aprova (copia para /records) ou descarta.
      // Imutáveis: para corrigir, o parceiro apaga e envia outra — assim a
      // dona nunca aprova um texto diferente do que viu.
      match /suggestions/{sugId} {
        allow read:   if ehDono(userId) || temGrant(userId);
        allow create: if temGrant(userId)
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.ownerUid == userId;
        allow delete: if ehDono(userId)
                      || (request.auth != null && request.auth.uid == resource.data.authorUid);
        allow update: if false;
      }
    }

    // Links de compartilhamento. O doc guarda só
    // { ownerUid, ownerName, createdAt, expiresAt } — nunca registros.
    //
    // Leitura por qualquer pessoa autenticada é intencional: o shareId é o
    // próprio segredo, e sem poder ler o doc a instrutora não teria como
    // resgatar o vínculo. A listagem fica restrita aos próprios links, então
    // não há como varrer shares de terceiros.
    match /shares/{shareId} {
      allow get:    if request.auth != null;
      allow list:   if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if ehDono(request.resource.data.ownerUid);
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
      allow update: if false;
    }

    // Permissões de leitura concedidas. ID obrigatório: {ownerUid}_{leitorUid}.
    match /grants/{grantId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.readerUid
            || request.auth.uid == resource.data.ownerUid);

      // Só cria se o share informado existir, for daquela dona e estiver válido.
      allow create: if request.auth != null
        && grantId == request.resource.data.ownerUid + '_' + request.auth.uid
        && request.resource.data.readerUid == request.auth.uid
        && request.resource.data.ownerUid != request.auth.uid
        && exists(/databases/$(database)/documents/shares/$(request.resource.data.shareId))
        && get(/databases/$(database)/documents/shares/$(request.resource.data.shareId)).data.ownerUid
             == request.resource.data.ownerUid
        && get(/databases/$(database)/documents/shares/$(request.resource.data.shareId)).data.expiresAt
             > request.time;

      // Tanto o leitor (desvincular) quanto a dona (revogar) podem apagar.
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.readerUid
            || request.auth.uid == resource.data.ownerUid);

      allow update: if false;
    }

    // Lista de alunas vinculadas de cada instrutora/parceiro (cache de nome).
    match /instructors/{instructorId}/students/{shareId} {
      allow read, write: if ehDono(instructorId);
    }

    // Qualquer outro caminho: negado por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

// Regras de Segurança do Firestore — Ciclo Consciente
// Garante que cada usuária só possa ler/escrever o PRÓPRIO documento
// de perfil e os PRÓPRIOS registros diários. Ninguém acessa dados de
// outra pessoa, mesmo manipulando o app pelo navegador.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      // Necessário para a função "Excluir minha conta" (LGPD).
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /records/{recordId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Links de compartilhamento (instrutora/parceiro). O documento em si
    // guarda só { ownerUid, ownerName, createdAt, expiresAt } — nunca os
    // registros. Só a dona pode criar/listar/revogar os próprios links;
    // NINGUÉM tem permissão de leitura pública aqui, de propósito.
    // A leitura pelo link público acontece via Cloud Function
    // (getSharedChart), que usa o Admin SDK e ignora estas regras —
    // é o único jeito de validar o token do link sem abrir uma brecha
    // de leitura para qualquer pessoa que descubra o UID de outra usuária.
    match /shares/{shareId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerUid;
      allow update: if false;
    }

    // Vínculos instrutora → aluna (painel B2B). Cada instrutora só lê/escreve
    // a PRÓPRIA lista de alunas vinculadas. O documento guarda apenas uma
    // referência ao shareId + o nome em cache — nunca os registros da aluna
    // (esses são buscados via Cloud Function, usando o shareId como token).
    match /instructors/{instructorId}/students/{shareId} {
      allow read, write: if request.auth != null && request.auth.uid == instructorId;
    }

    // Qualquer outro caminho: negado por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
